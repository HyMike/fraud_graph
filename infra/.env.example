# Copy to infra/.env and set real values:  cp infra/.env.example infra/.env
# infra/.env is gitignored — never commit it.
#
# Read by:
#   - docker compose (auto-loaded from this directory)
#   - ./gradlew bootRun / ./gradlew test in services/ring-detector
#
# Neo4j requires at least 8 characters. Note: Neo4j and Postgres only apply these
# on first start of an empty volume — to change them later, recreate the volumes
# (docker compose -f infra/docker-compose.yml down -v) and reload the graph.

NEO4J_PASSWORD=change-me
POSTGRES_PASSWORD=change-me

# ring-detector login: HMAC key used to sign JWTs (32+ characters, e.g. `openssl rand -base64 48`)
JWT_SIGNING_KEY=
# Password given to the seeded demo users analyst / lead / auditor / admin
SEED_USER_PASSWORD=
